{
  "rules": {
    ".read": false,
    ".write": false,
    "menu": {
      ".read": true,
      ".write": false
    },
    "version": {
      ".read": true,
      ".write": false
    },
    "Categories": {
      ".read": true,
      ".write": false
    },
    "MenuItems": {
      ".read": true,
      ".write": false
    },
    "Settings": {
      ".read": true,
      ".write": false
    },
    "WebSiteSettings": {
      ".read": true,
      ".write": false
    },
    "WebsiteData": {
      ".read": true,
      ".write": false
    },
    "Banners": {
      ".read": true,
      ".write": false
    },
    "_analytics": {
      ".read": true,
      ".write": true
    },
    "VisitorHistory": {
      ".read": true,
      ".write": true
    },
    "_incidents": {
      ".read": true,
      ".write": true
    },
    "Orders": {
      ".read": false,
      "$orderId": {
        ".read": false,
        ".write": "auth != null && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['items', 'orderDate', 'customerPhone', 'displayOrderId']) && newData.child('customerPhone').isString() && newData.child('orderDate').isString()"
      }
    },
    "DriverUpdates": {
      ".read": false,
      "$orderId": {
        ".read": false,
        ".write": "(!data.exists() || data.exists())"
      }
    },
    "PublicTracking": {
      ".read": false,
      "$orderId": {
        ".read": true,
        ".write": "auth != null && (!data.exists() || data.exists())"
      }
    },
    "OrderTracking": {
      ".read": false,
      "$orderId": {
        ".read": false,
        ".write": false
      }
    },
    "CancellationRequests": {
      ".read": false,
      "$requestId": {
        ".read": false,
        ".write": "auth != null && !data.exists() && newData.exists() && (!root.child('StoreStatus').exists() || root.child('StoreStatus').child('isOpen').val() != false) && (!root.child('Blacklist').child(newData.child('customerPhone').val()).exists() || root.child('Blacklist').child(newData.child('customerPhone').val()).child('isBlacklisted').val() != true)",
        ".validate": "newData.hasChildren(['orderDate', 'customerPhone', 'displayOrderId']) && newData.child('customerPhone').isString() && newData.child('customerPhone').val().matches(/^01[0125][0-9]{8}$/) && newData.child('orderDate').isString()"
      }
    },
    "ActiveHoldRequests": {
      ".read": false,
      "$orderId": {
        ".read": true,
        ".write": "auth != null && ((!data.exists() && newData.exists() && newData.hasChildren(['OrderId', 'CustomerPhone', 'StartedAt', 'ExpiresAt'])) || (data.exists() && !newData.exists()))"
      }
    },
    "OtpRateLimits": {
      ".read": false,
      "$phone": {
        ".read": false,
        ".write": "$phone.matches(/^01[0125][0-9]{8}$/) && (!data.exists() || (now - data.child('lastRequestedAt').val() >= 120000))",
        ".validate": "newData.hasChild('lastRequestedAt') && newData.child('lastRequestedAt').isNumber() && newData.child('lastRequestedAt').val() <= now"
      }
    },
    "PendingOtpRequests": {
      ".read": false,
      "$reqId": {
        ".read": false,
        ".write": "auth != null && !data.exists() && newData.exists() && newData.hasChildren(['phone', 'uid', 'createdAt'])"
      }
    },
    "CustomerLoginEmails": {
      ".read": true,
      "$phone": {
        ".write": "auth != null && root.child('UidToPhone').child(auth.uid).val() === $phone"
      }
    },
    "PublicCustomers": {
      ".read": false,
      "$phone": {
        ".read": "auth != null && root.child('UidToPhone').child(auth.uid).val() === $phone",
        ".write": "auth != null && root.child('UidToPhone').child(auth.uid).val() === $phone",
        ".validate": "$phone.matches(/^01[0125][0-9]{8}$/)"
      }
    },
    "UidToPhone": {
      ".read": false,
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "UsedReceipts": {
      ".read": false,
      "$hash": {
        ".read": true,
        ".write": "auth != null && !data.exists() && newData.val() === true"
      }
    },
    "Coupons": {
      ".read": false,
      "$code": {
        ".read": true,
        ".write": false
      }
    },
    "UsedCoupons": {
      ".read": false,
      "$code": {
        ".read": false,
        "$phone": {
          ".read": true,
          ".write": "auth != null && !data.exists() && newData.val() === true"
        }
      }
    },
    "Blacklist": {
      ".read": false,
      "$phone": {
        ".read": true,
        ".write": false
      }
    },
    "ApprovedReviews": {
      ".read": true,
      ".write": false
    },
    "PendingReviews": {
      ".read": false,
      "$reviewId": {
        ".read": false,
        ".write": "auth != null && !data.exists() && newData.exists() && newData.hasChildren(['customerName', 'rating', 'comment']) && newData.child('rating').isNumber() && newData.child('rating').val() >= 1 && newData.child('rating').val() <= 5 && newData.child('comment').val().length <= 500"
      }
    },
    "PendingPins": {
      ".read": false,
      ".write": false
    },
    "StoreStatus": {
      ".read": true,
      ".write": false
    },
    "PendingOtpVerifications": {
      ".read": false,
      "$reqId": {
        ".read": false,
        ".write": "auth != null && auth.uid === newData.child('uid').val() && !data.exists() && newData.exists() && newData.hasChildren(['phone', 'code', 'uid', 'createdAt'])"
      }
    },
    "OtpVerifications": {
      ".read": false,
      ".write": false
    },
    "OrderModificationRequests": {
      ".read": false,
      "$requestId": {
        ".read": false,
        ".write": "auth != null && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['items', 'orderDate', 'customerPhone', 'displayOrderId']) && newData.child('customerPhone').isString() && newData.child('orderDate').isString()"
      }
    },
    "ReceiptVerificationRequests": {
      ".read": false,
      "$reqId": {
        ".read": false,
        ".write": "auth != null && !data.exists() && newData.exists()"
      }
    },
    "OtpValidations": {
      ".read": false,
      "$reqId": {
        ".read": false,
        ".write": "auth != null && newData.exists() && newData.hasChildren(['guess', 'phone', 'uid'])"
      }
    },
    "OtpResults": {
      ".read": false,
      "$reqId": {
        ".read": "auth != null",
        ".write": false
      }
    },
    "GroupOrders": {
      ".read": true,
      "$groupId": {
        ".read": true,
        ".write": true
      }
    },
    "UserCarts": {
      "$phone": {
        ".read": true,
        ".write": true
      }
    }
  }
}